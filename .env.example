# Configuração Geral do Servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Configuração do Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///./vespera.db

# Parâmetros Padrão da Simulação
